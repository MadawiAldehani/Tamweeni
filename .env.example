# Tamweeni — copy to .env.local and fill in what you have.
# Leave everything empty to run in MOCK MODE (localStorage data, canned receipt parse).

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by /api/impact to aggregate across households. Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, /api/receipt/parse uses Claude vision instead of on-device OCR.
# Leave empty to stay at zero cost.
ANTHROPIC_API_KEY=
